FROM node:22-bookworm-slim AS builder

WORKDIR /src
COPY bbb-graphql-actions/package.json bbb-graphql-actions/package-lock.json ./
RUN npm ci --no-progress
COPY bbb-graphql-actions/tsconfig.json ./
COPY bbb-graphql-actions/src ./src
RUN npm run build \
    && cp package.json package-lock.json dist/ \
    && cd dist \
    && npm ci --no-progress --omit=dev

FROM node:22-bookworm-slim

RUN groupadd -g 2062 app \
    && useradd -m -u 2063 -g app app

WORKDIR /app
ENV NODE_ENV=production \
    SERVER_HOST=0.0.0.0 \
    SERVER_PORT=8093 \
    BBB_REDIS_HOST=redis \
    BBB_REDIS_PORT=6379

COPY --from=builder /src/dist /app
USER app
EXPOSE 8093
CMD ["node", "/app/index.js"]
